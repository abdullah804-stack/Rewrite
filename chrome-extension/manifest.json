{
  "manifest_version": 3,
  "name": "Rewrite Clipper",
  "version": "1.0",
  "description": "Send selected text to Rewrite from any website.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rewrite Clipper"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}