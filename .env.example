# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=

# --- Auth ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Redis (rate limits and the rewrite cache) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- LLM providers ---
# Providers are tried in this order. Only providers with a key are used.
# Override the order with a comma list, e.g. AI_PROVIDER_ORDER=deepseek  (no fallback)
# or AI_PROVIDER_ORDER=groq,openrouter. Default: deepseek,groq,openrouter
AI_PROVIDER_ORDER=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional extras
GOOGLE_AI_KEY=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Cron cleanup ---
CRON_SECRET=

# --- Benchmark only (see bench/README.md) ---
# When a request carries a matching benchKey, the server skips its cache and quota.
# Leave empty in production.
BENCH_KEY=
